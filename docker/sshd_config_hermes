# sshd config for in-container SSH access (used by Hermes Desktop SSH mode).
# Launched from docker/entrypoint.sh while still root, before privileges drop
# to the `hermes` user. Keep this file root-owned, mode 644.
Port 2222
ListenAddress 0.0.0.0
ListenAddress ::

# Auth: pubkey only, only the hermes user.
PermitRootLogin no
PasswordAuthentication no
ChallengeResponseAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /opt/data/.ssh/authorized_keys
AllowUsers hermes

# StrictModes is intentionally OFF: Docker bind mounts on Windows/macOS surface
# POSIX perms in ways OpenSSH refuses (group/world bits set even after chmod).
# The volume already lives in the user's home dir on the host, so the trust
# boundary is the same as the host filesystem.
StrictModes no

# Forwarding: Hermes Desktop needs -L for the API tunnel (18642 -> 8642).
AllowTcpForwarding yes
GatewayPorts no
X11Forwarding no
PermitTunnel no

# Persist host keys on the mounted volume so client `known_hosts` survives
# image rebuilds. Generated by entrypoint.sh if missing.
HostKey /opt/data/.ssh/sshd_host/ssh_host_ed25519_key
HostKey /opt/data/.ssh/sshd_host/ssh_host_rsa_key

# Misc hygiene
PrintMotd no
PrintLastLog no
UseDNS no
PidFile /run/sshd-hermes.pid
Subsystem sftp /usr/lib/openssh/sftp-server
